MISTRAL_API_KEY=your_mistral_key
GROQ_API_KEY=gsk_your_groq_key

# Optional overrides (copy exact IDs from each console if these are retired)
MISTRAL_MODEL=ministral-8b-latest
GROQ_MODEL=openai/gpt-oss-120b

# Voice path: one entry per independent rate-limit bucket, fastest first.
# Groq publishes limits PER MODEL, so a second Groq model is a second 8,000 tok/min budget.
VOICE_MODEL_ORDER=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,mistral
# How long to step over a model that just rate-limited, before probing it again.
MODEL_RATE_LIMIT_TTL_S=30
# gpt-oss streams a reasoning block before the first visible token; 'low' is the floor.
GROQ_REASONING_EFFORT=low
VOICE_MAX_TOKENS=160
VOICE_TIMEOUT_S=8
# Free tier is 8,000 tokens/minute. Set >0 to window history on the voice path.
MAX_HISTORY_TOKENS=0

# Optional: real email via Gmail (needs an App Password, not your normal password).
# Leave blank to "dry-run" - emails are saved to ./outbox instead.
SMTP_USER=
SMTP_PASSWORD=

# Observability: every LLM call, tool call and turn is appended here as JSON lines. Empty = off.
TRACE_PATH=traces.jsonl

# Optional: full trace tree (prompts, tool args, latency per step) in LangSmith, free tier.
# Note it sends prompts and completions to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=shoe-agent

# Bearer token the voice endpoint requires. Set before exposing the port through a tunnel.
VOICE_SHARED_SECRET=
# ElevenLabs key (restricted: Agents write, User/Voices/Models read). python check_elevenlabs.py
ELEVENLABS_API_KEY=
# The ElevenLabs agent that talks to voice_server.py (python connect_elevenlabs.py updates its URL)
ELEVENLABS_AGENT_ID=
