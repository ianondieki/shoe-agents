MISTRAL_API_KEY=your_mistral_key
GROQ_API_KEY=gsk_your_groq_key

# Optional overrides (copy exact IDs from each console if these are retired)
MISTRAL_MODEL=ministral-8b-latest
GROQ_MODEL=openai/gpt-oss-120b

# Voice path: one entry per independent rate-limit bucket, fastest first.
# Groq publishes limits PER MODEL, so a second Groq model is a second 8,000 tok/min budget.
VOICE_MODEL_ORDER=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,mistral
# How long to step over a model that just rate-limited, before probing it again.
MODEL_RATE_LIMIT_TTL_S=30
# gpt-oss streams a reasoning block before the first visible token; 'low' is the floor.
GROQ_REASONING_EFFORT=low
VOICE_MAX_TOKENS=160
VOICE_TIMEOUT_S=8
# Free tier is 8,000 tokens/minute. Set >0 to window history on the voice path.
MAX_HISTORY_TOKENS=0

# Optional: real email via Gmail (needs an App Password, not your normal password).
# Leave blank to "dry-run" - emails are saved to ./outbox instead.
SMTP_USER=
SMTP_PASSWORD=

# Observability: every LLM call, tool call and turn is appended here as JSON lines. Empty = off.
TRACE_PATH=traces.jsonl

# Optional: full trace tree (prompts, tool args, latency per step) in LangSmith, free tier.
# Note it sends prompts and completions to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=shoe-agent

# Bearer token the voice endpoint requires. Set before exposing the port through a tunnel.
VOICE_SHARED_SECRET=
# ElevenLabs key (restricted: Agents write, User/Voices/Models read). python check_elevenlabs.py
ELEVENLABS_API_KEY=
# The ElevenLabs agent that talks to voice_server.py (python connect_elevenlabs.py updates its URL)
ELEVENLABS_AGENT_ID=

# ---------- the web shop and the WhatsApp channel (python server.py) ----------
# One process serves the shop, WhatsApp, M-Pesa's callback and the ElevenLabs phone endpoint.
SERVER_PORT=8013
# Signs the browser's session cookie and its CSRF token. Any long random string; change it and
# everyone is signed out. Leave blank locally and one is made per run.
WEB_SECRET=
# Where this server can be reached from outside, for the links WhatsApp sends:
#   cloudflared tunnel --protocol quic --url http://localhost:8013
PUBLIC_URL=

# ---------- M-Pesa (Daraja sandbox: no real money) ----------
# developer.safaricom.co.ke -> My Apps -> the sandbox app's Consumer Key and Secret.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox till and passkey from the "Lipa Na M-Pesa Online" simulator page.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Where Safaricom posts the result. Must be https, so it is the tunnel URL, and it ends with the
# token below so a stranger who finds the path cannot post a fake "paid".
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
# Prices on the shelf are dollars; the prompt is in shillings. One pair, one conversion.
KES_PER_USD=130

# ---------- WhatsApp (Meta Cloud API test number: free) ----------
# developers.facebook.com -> your app -> WhatsApp. Nothing here costs money on a test number.
# Any random string; type the same one into Meta's webhook form next to the callback URL.
WA_VERIFY_TOKEN=
# App settings -> Basic -> App secret. Every webhook is signed with it; without it none are accepted.
WA_APP_SECRET=
# WhatsApp -> API setup: the temporary token, or a System User token with whatsapp_business_messaging.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

